
config komari_agent 'agent'
	option enabled '0'
	option endpoint ''
	option token ''
	option interval '3'
	option disable_web_ssh '1'
	option ignore_unsafe_cert '0'
	option include_nics 'pppoe-wan'
	option exclude_nics ''
	option include_mountpoints '/'

	# IP 上报来源：auto=外部接口探测 / nic=读网卡 / custom=固定值
	option ip_mode 'auto'
	option reconnect_interval '5'
	option max_retries '3'

	# 日志上限（KB）：写入 /tmp/log/komari-agent.log（tmpfs 内存）
	# 超过后自动裁剪并保留尾部一半；不会占用闪存，也不进 syslog
	option log_max_size '256'

	# 下载源：开关关闭=只直连 GitHub
	# 开启后先用「镜像前缀+原始 GitHub 地址」下载，失败自动回退直连
	# 前缀可自行换成其他镜像站，须为 http(s)://主机/路径/ 并以 / 结尾
	# 文件仍按 GitHub API 的 SHA256 校验，镜像无法替换内容
	option download_mirror_enable '0'
	option download_mirror ''
